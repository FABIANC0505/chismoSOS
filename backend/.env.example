# ==========================================
# chismOSOS Backend - Variables de Entorno
# ==========================================

# Clave secreta para JWT (genera una cadena segura y aleatoria)
SECRET_KEY=tu_clave_secreta_super_segura_jwt_colombia_2026

# Base de datos (opcional: por defecto usa SQLite local 'chismos_os.db')
# Para Render o Neon PostgreSQL: postgresql://usuario:password@host:5432/dbname
DATABASE_URL=

# URL del Frontend en producción (para autorizar peticiones CORS)
# Ejemplo: https://chismosos.vercel.app
FRONTEND_URL=

# ==========================================
# Cloudflare R2 - Almacenamiento de Fotos
# ==========================================
# ID de tu cuenta de Cloudflare (se encuentra en el panel de Cloudflare)
R2_ACCOUNT_ID=

# Token de API de R2 con permisos de lectura/escritura en el bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket creado en Cloudflare R2
R2_BUCKET_NAME=chismosos-fotos

# Dominio público del bucket (puede ser el subdominio gratuito .r2.dev o un dominio personalizado)
# Ejemplo: https://pub-xxxxxxxxxxxxxx.r2.dev o https://fotos.chismosos.com
R2_PUBLIC_DOMAIN=
